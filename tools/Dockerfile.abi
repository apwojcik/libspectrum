FROM debian:12

# autoconf/automake/libtool are only needed to build refs that predate the
# move to CMake (see check-abi-in-docker.sh).
RUN apt-get update && apt-get install -y \
    abi-compliance-checker \
    abi-dumper \
    autoconf \
    automake \
    build-essential \
    file \
    git \
    libbz2-dev \
    libtool \
    pkg-config \
    perl \
    python3 \
    python3-pip \
    universal-ctags \
    zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*

# CMakeLists.txt requires a newer CMake than Debian 12 ships.
RUN pip3 install --break-system-packages cmake

WORKDIR /work
