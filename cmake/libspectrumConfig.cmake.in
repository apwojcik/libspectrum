@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# A SHARED spectrum::spectrum keeps these as a private implementation
# detail. A STATIC build re-exposes its PRIVATE link libraries for
# linking (CMake wraps them in $<LINK_ONLY:...>), so a consumer linking
# a static libspectrum must be able to find them too.
if(NOT @BUILD_SHARED_LIBS@)
    if(@HAVE_ZLIB_H@)
        find_dependency(ZLIB)
    endif()
    if(@HAVE_LIBBZ2@)
        find_dependency(BZip2)
    endif()
    if(@HAVE_LIB_GLIB@)
        find_dependency(PkgConfig)
        pkg_check_modules(GLIB REQUIRED IMPORTED_TARGET glib-2.0)
    endif()
    if(@audiofile_FOUND@)
        find_dependency(PkgConfig)
        pkg_check_modules(AUDIOFILE REQUIRED IMPORTED_TARGET audiofile)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/libspectrumTargets.cmake")
